# Salin file ini menjadi .env lalu isi nilainya.
# Jika DATABASE_URL kosong / tidak ada, aplikasi memakai SQLite lokal (keuangan.db).

# Connection string Supabase (Project Settings -> Database -> Connection string).
# Disarankan memakai "Session pooler" (port 5432) agar kompatibel dengan IPv4.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Opsional: kunci sesi Flask. Jika kosong, dibuat otomatis di file .secret_key.
# SECRET_KEY=ganti-dengan-string-acak-panjang
